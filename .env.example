# Copy this file to .env and supply a server-side Gemini API key.
# Gemini Free Tier has rate/usage limits and is intended here for normal demo use.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite when omitted.
GEMINI_MODEL=gemini-3.5-flash-lite
# Per authenticated user: 20 chatbot requests every 5 minutes.
CHATBOT_RATE_LIMIT=20
CHATBOT_RATE_WINDOW_SECONDS=300
