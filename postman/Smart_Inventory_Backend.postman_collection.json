        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login/",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Admin login returns access and refresh tokens', function () {",
                  "  pm.expect(body.access).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refresh).to.be.a('string').and.not.empty;",
                  "});",
                  "if (body.access) pm.environment.set('adminAccessToken', body.access);",
                  "if (body.refresh) pm.environment.set('adminRefreshToken', body.refresh);"
                ]
              }
            }
          ]
        },
