{
  "info": {
    "_postman_id": "6f3a5bb8-3bd3-4f82-aaf3-0ab55c1b6fc0",
    "name": "Smart Inventory DSS - Backend Smoke Tests",
    "description": "Read-only API smoke checks and safe authentication/authorization checks for the backend. Run against a local or staging database, never production. Cash-flow and invoice file uploads are excluded because they create business records and require sample files.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminAccessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedByName = {",
          "  'Secure status without token': 401,",
          "  'Customer login missing credentials': 400,",
          "  'Manager cannot list staff users': 403,",
          "  'Staff cannot edit reorder threshold': 403,",
          "  'Manager threshold rejects invalid value': 400",
          "};",
          "const requestName = pm.info.requestName || '';",
          "const expectedStatus = expectedByName[requestName] || 200;",
          "pm.test(`HTTP status is ${expectedStatus}`, function () {",
          "  pm.response.to.have.status(expectedStatus);",
          "});",
          "pm.test('Response is JSON', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
          "});"
        ]
      }
    }
  ],
